# Bolt Markets website build settings.
# VITE_* values are compiled into the public JavaScript: put only public information here,
# never API keys or passwords. Leave a value empty and the section that needs it stays hidden.
# In GitHub, set these as repository "Variables" (Settings → Secrets and variables → Actions → Variables).

# --- hosting ------------------------------------------------------------------------------------
# Path the site is served from: "bolt-markets" for https://<user>.github.io/bolt-markets/, empty for a custom domain
VITE_BASE_PATH=bolt-markets
# Absolute public URL including the path (used for canonical links, sitemap and Open Graph)
VITE_SITE_URL=https://<github-user>.github.io/bolt-markets
# URL of the Bolt Markets API (backend), e.g. https://bolt-markets-api.onrender.com
VITE_API_URL=

# --- company and regulation (shown in the footer and legal pages only when set) ------------------
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_REG_NUMBER=
VITE_COMPANY_ADDRESS=
# "regulated" or "unregulated"
VITE_REGULATORY_STATUS=
# when regulated:
VITE_REGULATOR_NAME=
VITE_LICENSE_NUMBER=
# when unregulated: the jurisdiction of incorporation
VITE_JURISDICTION=
VITE_GOVERNING_LAW=
# ISO country codes you do not accept, e.g. US,KP,IR (also set RESTRICTED_COUNTRIES on the API)
VITE_RESTRICTED_COUNTRIES=
# Set to true only after a lawyer has approved the legal documents (removes the draft banner)
VITE_LEGAL_REVIEWED=false
# Effective date printed on legal documents, e.g. 2027-01-15
VITE_LEGAL_EFFECTIVE_DATE=

# --- support and community -------------------------------------------------------------------------
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
# international number, digits only, e.g. 9715XXXXXXXX
VITE_SUPPORT_WHATSAPP=
# crisp | tawk | intercom
VITE_LIVE_CHAT_PROVIDER=
VITE_LIVE_CHAT_ID=
VITE_SOCIAL_X=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_DISCORD=

# --- MetaTrader 5 ------------------------------------------------------------------------------------
VITE_MT5_SERVER_LIVE=
VITE_MT5_SERVER_DEMO=
# Branded installers from your MT5 provider (defaults to the official MetaQuotes downloads)
VITE_MT5_DOWNLOAD_WINDOWS=
VITE_MT5_DOWNLOAD_MAC=
VITE_MT5_DOWNLOAD_IOS=
VITE_MT5_DOWNLOAD_ANDROID=
VITE_MT5_WEB_TERMINAL=
# Broker-specific WebTerminal URL to embed on the Web Trader page
VITE_MT5_WEB_TERMINAL_EMBED=

# --- features --------------------------------------------------------------------------------------------
VITE_ECONOMIC_CALENDAR=true
VITE_TRADINGVIEW_WIDGETS=true
# Clearly labelled simulated prices for design review only — never enable on the live site
VITE_DEMO_PRICES=false
