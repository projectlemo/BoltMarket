{
  "name": "bolt-markets-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Bolt Markets public website and client portal (React + Vite + Tailwind + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "build:offline": "node scripts/build-offline.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/manrope": "^5.2.5",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.5",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
