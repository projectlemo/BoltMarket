# Bolt Markets API — environment variables
# Copy to .env for local development. NEVER commit real secrets: .env is git-ignored,
# and production values belong in your host's secret settings (Render/Railway dashboard).
# Anything left empty keeps that feature switched off.

# --- core -----------------------------------------------------------------------------------
# development | production
ENVIRONMENT=development
# production: 32+ random characters (signs sessions)
SECRET_KEY=
# production: 32+ random characters (encrypts KYC files and 2FA secrets; never change once set)
DATA_KEY=
# production: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./bolt.db
# e.g. https://<github-user>.github.io/bolt-markets or your domain
FRONTEND_URL=http://localhost:5173
# e.g. https://<github-user>.github.io/bolt-markets/admin
ADMIN_URL=http://localhost:5174
# public URL of this API (webhook endpoints are built from it); on Render it defaults to RENDER_EXTERNAL_URL
PUBLIC_API_URL=http://localhost:8000
# extra allowed origins, comma separated (FRONTEND_URL and ADMIN_URL origins are added automatically)
CORS_ORIGINS=
# true/false; defaults to on outside production
API_DOCS=
LOG_LEVEL=INFO
AUTO_MIGRATE=true

# --- accounts & security --------------------------------------------------------------------
# defaults to false in production until you switch it on
REGISTRATION_OPEN=
# ISO codes, e.g. US,KP,IR (needs your legal input)
RESTRICTED_COUNTRIES=
ADMIN_REQUIRE_2FA=true
# creates the first back-office admin on start (once)
BOOTSTRAP_ADMIN_EMAIL=
# 10+ characters with a letter and a number; change it after first login
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- email (SMTP) ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_FROM=Bolt Markets <no-reply@your-domain>
# staff notifications (contact form, tickets, KYC queue, withdrawals)
SUPPORT_INBOX=

# --- MetaTrader 5 ---------------------------------------------------------------------------
# disabled | webapi | bridge   (mock is for development only)
MT5_MODE=disabled
# https://your-mt5-access-server:443 (Web API enabled on the server)
MT5_WEBAPI_URL=
MT5_MANAGER_LOGIN=
MT5_MANAGER_PASSWORD=
MT5_WEBAPI_VERIFY_TLS=true
# when MT5_MODE=bridge: URL of backend/bridge/mt5_manager_bridge.py
MT5_BRIDGE_URL=
MT5_BRIDGE_KEY=
# server name clients type into MT5, e.g. BoltMarkets-Live
MT5_SERVER_LIVE=
MT5_SERVER_DEMO=
MT5_GROUP_STANDARD=real\standard
MT5_GROUP_PRO=real\pro
MT5_GROUP_INSTITUTIONAL=real\institutional
MT5_GROUP_DEMO=demo\standard
MT5_GROUP_FUNDED=demo\funded
DEMO_BALANCE=10000
ACCOUNT_CURRENCIES=USD
LEVERAGE_OPTIONS=50,100,200,300,400,500
ACCOUNT_SYNC_MINUTES=10

# --- live prices ----------------------------------------------------------------------------
# disabled | bridge | terminal | simulated (simulated is blocked in production)
QUOTES_MODE=disabled
# shared with backend/bridge/mt5_quote_bridge.py
QUOTES_BRIDGE_KEY=
# defaults to the 38 instruments listed on the website
QUOTE_SYMBOLS=
# QUOTES_MODE=terminal only (Windows host with MetaTrader 5)
MT5_TERMINAL_PATH=
MT5_TERMINAL_LOGIN=
MT5_TERMINAL_PASSWORD=
MT5_TERMINAL_SERVER=

# --- payments -------------------------------------------------------------------------------
# card deposits (Stripe Checkout)
STRIPE_SECRET_KEY=
# endpoint: <PUBLIC_API_URL>/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# crypto deposits (NOWPayments invoices)
NOWPAYMENTS_API_KEY=
# IPN endpoint: <PUBLIC_API_URL>/api/v1/webhooks/nowpayments
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
MIN_DEPOSIT=10
MIN_WITHDRAWAL=10
REQUIRE_KYC_FOR_DEPOSIT=true

# --- KYC ------------------------------------------------------------------------------------
# manual | sumsub
KYC_PROVIDER=manual
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
# webhook: <PUBLIC_API_URL>/api/v1/webhooks/sumsub
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
# database | local
KYC_STORAGE=database
MAX_UPLOAD_MB=10

# --- Bolt Funded (keep in sync with frontend/src/config/funded.ts) ----------------------------
FUNDED_PLANS=10000:99,25000:199,50000:299,100000:499,200000:949
FUNDED_LEVERAGE=100
FUNDED_MAX_DAILY_LOSS=5
FUNDED_MAX_OVERALL_LOSS=10
FUNDED_PHASE1_TARGET=8
FUNDED_PHASE2_TARGET=5

# --- optional: rebuild the static site when a blog post is published ---------------------------
# fine-grained token with "Contents: read & write" on the repo
GITHUB_DISPATCH_TOKEN=
# <github-user>/bolt-markets
GITHUB_REPOSITORY=
